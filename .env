# LAKSHYA — example environment configuration
#
# Copy to .env for local development:  cp .env.example .env
# This file contains PLACEHOLDERS ONLY. Never commit real credentials.
# Production secrets come from an approved secret manager (see docs/architecture/SECURITY.md §8).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# local | staging | production
# "production" refuses debug mode, placeholder secrets, insecure cookies and
# permissive CORS at startup (fail-fast settings layer).
LAKSHYA_ENVIRONMENT=local

# Never enable in staging or production.
LAKSHYA_DEBUG=true

# info | debug | warning | error
LAKSHYA_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL only. SQLite is not supported.
# The API runtime role must NOT own the schema and must NOT hold DDL rights.
# Use a separate migration role for Alembic (docs/architecture/SECURITY.md §9).

LAKSHYA_DATABASE_URL=postgresql+psycopg://lakshya:St%40vya123@localhost:5432/lakshya

# Optional: separate URL used only by Alembic. Falls back to LAKSHYA_DATABASE_URL.
# LAKSHYA_MIGRATION_DATABASE_URL=postgresql+psycopg://lakshya_migrator:change-me-locally@localhost:5432/lakshya_dev

# Database role that receives the audit-table REVOKE in migration 0002.
# Leave empty to skip the REVOKE (local development where one role does everything).
LAKSHYA_DB_APP_ROLE=

LAKSHYA_DB_POOL_SIZE=5
LAKSHYA_DB_MAX_OVERFLOW=5
LAKSHYA_DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Sessions and CSRF
# ---------------------------------------------------------------------------
# Opaque, database-backed sessions (ADR-002). No browser bearer tokens.

LAKSHYA_SESSION_COOKIE_NAME=lakshya_session
LAKSHYA_CSRF_COOKIE_NAME=lakshya_csrf

# Set to false ONLY for plain-HTTP local development. Must be true elsewhere.
LAKSHYA_SESSION_COOKIE_SECURE=false

# Absolute session lifetime and inactivity timeout, in minutes.
LAKSHYA_SESSION_ABSOLUTE_LIFETIME_MINUTES=720
LAKSHYA_SESSION_IDLE_TIMEOUT_MINUTES=60

# ---------------------------------------------------------------------------
# HTTP security
# ---------------------------------------------------------------------------
# Same-origin deployment is preferred. CORS is deny-by-default: an empty list
# means no cross-origin browser access at all. Wildcards are rejected.
LAKSHYA_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origins accepted by the CSRF Origin/Referer check for unsafe methods.
# Must contain the browser origin that serves the LAKSHYA web application.
LAKSHYA_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Argon2id password hashing (docs/architecture/SECURITY.md §3)
# ---------------------------------------------------------------------------
# Benchmark these for the production host before go-live.
LAKSHYA_ARGON2_TIME_COST=3
LAKSHYA_ARGON2_MEMORY_COST_KIB=65536
LAKSHYA_ARGON2_PARALLELISM=2

# Minimum password length. Full password policy and breached-password
# screening are REQUIRES BUSINESS DECISION (SECURITY.md §3).
LAKSHYA_PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Login rate limiting
# ---------------------------------------------------------------------------
# In-process limiter — correct for a single API process only.
# A shared store is required before horizontal scaling (SECURITY.md §10).
LAKSHYA_LOGIN_RATE_LIMIT_ATTEMPTS=10
LAKSHYA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Local development bootstrap (NOT a production authorization model)
# ---------------------------------------------------------------------------
# Guard for app/scripts/bootstrap_local.py. The script refuses to run unless
# LAKSHYA_ENVIRONMENT=local AND this flag is true. See docs/implementation/
# PHASE2_FOUNDATION.md §"Local bootstrap".
LAKSHYA_ALLOW_LOCAL_BOOTSTRAP=false

# ---------------------------------------------------------------------------
# Docker Compose (local development only)
# ---------------------------------------------------------------------------
# Used by docker-compose.yml to provision the local PostgreSQL container.
# These are local-development-only values and are not a production credential
# source. Inside Compose the API reaches the database at host "db".
COMPOSE_POSTGRES_DB=lakshya_dev
COMPOSE_POSTGRES_USER=lakshya
COMPOSE_POSTGRES_PASSWORD=change-me-locally
COMPOSE_POSTGRES_PORT=5432
COMPOSE_API_PORT=8000

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Database-backed tests are SKIPPED unless this is set. It must point at a
# throwaway database: the suite creates and drops schema objects in it.
LAKSHYA_TEST_DATABASE_URL=postgresql+psycopg://lakshya:St%40vya123@localhost:5432/lakshya_test
