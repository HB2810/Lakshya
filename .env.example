# ===========================================================================
# STAVYA ONE (LAKSHYA) — Environment Configuration Template
# ===========================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env

# --- Deployment Environment ---
# Options: local, staging, production
LAKSHYA_ENVIRONMENT=local
LAKSHYA_DEBUG=false
LAKSHYA_LOG_LEVEL=info

# --- PostgreSQL Database ---
POSTGRES_USER=lakshya
POSTGRES_PASSWORD=lakshya_secure_pass
POSTGRES_DB=lakshya_prod
POSTGRES_PORT=5432

# FastAPI Database Connection URL (Async / Psycopg 3)
LAKSHYA_DATABASE_URL=postgresql+psycopg://lakshya:lakshya_secure_pass@db:5432/lakshya_prod
LAKSHYA_ALLOW_LOCAL_BOOTSTRAP=false

# --- Security & CSRF ---
# Set to true when serving over HTTPS
LAKSHYA_SESSION_COOKIE_SECURE=false
LAKSHYA_SESSION_ABSOLUTE_LIFETIME_MINUTES=720
LAKSHYA_SESSION_IDLE_TIMEOUT_MINUTES=120

# Trusted origins for CORS and CSRF protection (comma-separated)
LAKSHYA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
LAKSHYA_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Frontend Configuration ---
# In Docker or production, frontend proxies /api to this backend endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
