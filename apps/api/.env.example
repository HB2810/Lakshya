# FastAPI Backend Environment Configuration
LAKSHYA_ENVIRONMENT=local
LAKSHYA_DEBUG=false
LAKSHYA_LOG_LEVEL=info
LAKSHYA_API_PREFIX=/api/v1

# PostgreSQL Database Connection
# In Docker: postgresql+psycopg://lakshya:lakshya_secure_pass@db:5432/lakshya_prod
# Locally: postgresql+psycopg://lakshya:lakshya@localhost:5432/lakshya_dev
LAKSHYA_DATABASE_URL=postgresql+psycopg://lakshya:lakshya_secure_pass@db:5432/lakshya_prod
LAKSHYA_ALLOW_LOCAL_BOOTSTRAP=false

# Security & Sessions
LAKSHYA_SESSION_COOKIE_NAME=lakshya_session
LAKSHYA_CSRF_COOKIE_NAME=lakshya_csrf
LAKSHYA_SESSION_COOKIE_SECURE=false
LAKSHYA_SESSION_ABSOLUTE_LIFETIME_MINUTES=720
LAKSHYA_SESSION_IDLE_TIMEOUT_MINUTES=120

# CORS & Trusted Origins
LAKSHYA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
LAKSHYA_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
